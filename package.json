{
  "name": "tendi-family-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Family API for Tendi. The only writer of the family tables and the mirrored parent columns.",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run db:test:reset",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:api": "vitest run test/api",
    "test:db": "vitest run test/db",
    "db:dev:reset": "tsx scripts/db-reset.ts --target dev",
    "db:test:reset": "tsx scripts/db-reset.ts --target test",
    "db:verify-schema": "tsx scripts/verify-schema.ts",
    "family:dev-token": "tsx scripts/dev-token.ts",
    "family:reconcile": "tsx scripts/reconcile.ts",
    "export:openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/autoload": "6.5.1",
    "@fastify/cors": "11.4.1",
    "@fastify/env": "7.0.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@fastify/type-provider-typebox": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "ioredis": "6.0.0",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "secure-json-parse": "4.1.1",
    "typebox": "1.4.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
