# Copy to .env (git-ignored) and fill in. No inline comments after values.
# The app validates these at startup (src/config.ts) and stops with a clear error if one is wrong.

# --- API server -----------------------------------------------------------------------------
# NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Allowed browser origins, comma-separated: Tendi-new runs on port 3000 locally.
CORS_ORIGIN=http://localhost:3000
# Optional until Step 2.3 (Memurai or Redis under WSL); empty or unset = no Redis.
REDIS_URL=
# DB_POOL_SIZE=10

# --- Database (used by the API and by the db:family:* scripts) ------------------------------
#
# Local MariaDB 10.11 only (production runs 10.11.9). Never point these at a shared
# or production host. The db:family:* scripts refuse any DB_HOST other than
# localhost / 127.0.0.1 / ::1, any database not named tendi_family_*, and any server
# whose @@hostname is not this machine.
DB_HOST=127.0.0.1
DB_PORT=3306
# Needs DROP/CREATE DATABASE and TRIGGER on tendi_family_* (local root is fine).
DB_USER=root
DB_PASSWORD=

# Development database: npm run db:family:restore drops it and loads the 2026-09-24 dump.
DB_NAME=tendi_family_dev
# The family module's own database account (scripts/family/grants.sql; npm run db:family:grants
# creates it with this password and applies the grants). Choose a strong local password.
FAMILY_DB_USER=family_api
FAMILY_DB_PASSWORD=
# FAMILY_DB_POOL_SIZE=10
# admin.type values allowed to use the Family API (decision D5, to be confirmed), comma-separated;
# default admin,superadmin,office.
# FAMILY_ALLOWED_STAFF_TYPES=admin,superadmin,office

# Test database for the step 1.6 and 3.8 suites: npm run db:family:test-clone copies DB_NAME into it.
DB_TEST_NAME=tendi_family_test

# The 2026-09-24 dump (kept outside the repo). Forward slashes.
FAMILY_DUMP_PATH=C:/Users/<you>/Downloads/raul-tendi-db-2026-09-24.sql

# Optional: performance target for npm run test:family-db (median of 7 runs), default 200.
# FAMILY_DB_PERF_TARGET_MS=200

# Optional: folder with mysql.exe and mysqldump.exe when they are not on PATH
# (the scripts also look in C:/Program Files/MariaDB 10.11/bin).
# MARIADB_BIN_DIR=C:/Program Files/MariaDB 10.11/bin
