# Copy to .env. Never commit .env. No production host in development.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Local MariaDB 10.11 only, unless NODE_ENV=production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tendi_family_dev
FAMILY_DB_USER=family_api
FAMILY_DB_PASSWORD=

# Used only by db:reset and db:verify-schema. Not used by the API process.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Path to the mariadb client. Empty uses the Windows installer's path on Windows and `mariadb` on PATH elsewhere.
MARIADB_BIN=
DB_POOL_SIZE=10

# Comma-separated browser origins for Tendi-new. Production refuses a localhost origin and an empty FAMILY_DB_PASSWORD.
CORS_ORIGIN=http://127.0.0.1:3001

# Staff who may call the family routes. superadmin is open item D5 and is not included yet.
ALLOWED_STAFF_TYPES=admin,office

# Who may add or change relationship types.
RELATIONSHIP_ADMIN_TYPES=admin,superadmin

LOG_LEVEL=info

# Behind a load balancer: true, a hop count, or comma-separated proxy addresses. Empty uses the socket address.
TRUST_PROXY=

# Requests a minute, per IP and per token.
RATE_LIMIT_PER_MINUTE=300
# redis:// or rediss:// URL. Set it when more than one API instance runs, so they share one count. Empty keeps counts in the process.
RATE_LIMIT_REDIS_URL=
